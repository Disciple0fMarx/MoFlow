\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Qualitative comparison on a bookstore window: no-video, global and agent-centric conditioning. In a dense, structured scene the visual branches anchor the sampled futures to the walkable area. }}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:bookstore}{{3}{4}{Qualitative comparison on a bookstore window: no-video, global and agent-centric conditioning. In a dense, structured scene the visual branches anchor the sampled futures to the walkable area}{figure.caption.4}{}}
