\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Kinematics-only baseline of the MoFlow Teacher ($NV$): the past trajectory is compressed by a kinematics encoder into $h_{kin}$, and the conditional flow-matching decoder regresses the future distribution. }}{2}{figure.caption.1}\protected@file@percent }
\newlabel{fig:arch-baseline}{{1}{2}{Kinematics-only baseline of the MoFlow Teacher ($NV$): the past trajectory is compressed by a kinematics encoder into $h_{kin}$, and the conditional flow-matching decoder regresses the future distribution}{figure.caption.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Global Video Encoder Architecture}{2}{section.2}\protected@file@percent }
\newlabel{sec:global}{{2}{2}{Global Video Encoder Architecture}{section.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Global-video extension ($GV$): the observed clip is embedded by the video backbone, pooled into a scene-level token $v_{global}$, and fused with the trajectory stream before the flow-matching decoder. }}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:arch-global}{{2}{3}{Global-video extension ($GV$): the observed clip is embedded by the video backbone, pooled into a scene-level token $v_{global}$, and fused with the trajectory stream before the flow-matching decoder}{figure.caption.2}{}}
