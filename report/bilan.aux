\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Agent-centric extension ($AV$): per-agent crops around the target are encoded into local tokens that condition a cross-attention where the kinematic state acts as query; the locally fused context $c_{vis}$ is then combined with the trajectory stream before the flow-matching decoder. }}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:arch-agent}{{4}{5}{Agent-centric extension ($AV$): per-agent crops around the target are encoded into local tokens that condition a cross-attention where the kinematic state acts as query; the locally fused context $c_{vis}$ is then combined with the trajectory stream before the flow-matching decoder}{figure.caption.5}{}}
